{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/earthwalker17/AI-videos/blob/main/schemas/video.v1.json",
  "title": "video.json v1: one video slot",
  "$comment": "Generated by `pnpm aiv check --fix`; do not edit by hand.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "titles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "series": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 48,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "brief",
        "treatment",
        "production",
        "review",
        "locked",
        "published",
        "archived"
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "treatment",
              "review",
              "final"
            ]
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "gate",
          "date"
        ],
        "additionalProperties": false
      }
    },
    "next": {
      "type": "string"
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 48,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "reproducibility": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "metadata-only"
      ]
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "type": "string"
    },
    "format": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^lavfi:.+"
                  },
                  {
                    "type": "string",
                    "pattern": "^audio:[a-z0-9][a-z0-9-]*$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(?![/\\\\])(?!.*[\\\\:])(?!(?:.*\\/)?\\.\\.(?:\\/|$)).+$"
                  }
                ]
              },
              "gainDb": {
                "type": "number"
              },
              "start": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tracks"
      ],
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "properties": {
        "swatchFrames": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "loudness": {
          "type": "object",
          "properties": {
            "integrated": {
              "type": "number"
            },
            "tolerance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "truePeakMax": {
              "type": "number"
            }
          },
          "required": [
            "integrated",
            "tolerance",
            "truePeakMax"
          ],
          "additionalProperties": false
        },
        "allowBlack": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "allowFreeze": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "reusable": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "what"
        ],
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "film": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "film"
      ],
      "additionalProperties": false
    },
    "youtube": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            },
            "published": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "release": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "format": "uri"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repo",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "number",
    "slug",
    "title",
    "series",
    "status",
    "approvals",
    "languages",
    "styles",
    "reproducibility",
    "reusable",
    "license",
    "youtube",
    "release",
    "source"
  ],
  "additionalProperties": false
}
