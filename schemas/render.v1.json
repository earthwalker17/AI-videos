{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/earthwalker17/AI-videos/blob/main/schemas/render.v1.json",
  "title": "render.json v1: what an engine hands to post",
  "$comment": "Generated by `pnpm aiv check --fix`; do not edit by hand.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "adapterVersion": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "adapterVersion"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "composition": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "entry"
      ]
    },
    "profile": {
      "type": "string"
    },
    "frames": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start",
        "end",
        "count"
      ]
    },
    "composition": {
      "type": "object",
      "properties": {
        "durationFrames": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "durationFrames"
      ]
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "color": {
      "type": "object",
      "properties": {
        "space": {
          "type": "string",
          "enum": [
            "rgb",
            "bt709",
            "bt601"
          ]
        },
        "range": {
          "type": "string",
          "enum": [
            "pc",
            "tv"
          ]
        }
      },
      "required": [
        "space",
        "range"
      ]
    },
    "mezzanine": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*\\\\)(?!(?:.*\\/)?\\.\\.(?:\\/|$)).+$"
        },
        "codec": {
          "type": "string"
        },
        "pixFmt": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "codec",
        "pixFmt",
        "bytes",
        "sha256"
      ]
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "dirty"
      ]
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "pnpm": {
          "type": "string"
        },
        "ffmpeg": {
          "type": "string"
        },
        "ffmpegBuildconfHash": {
          "type": "string"
        },
        "browser": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "gpu": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "ffmpeg",
        "ffmpegBuildconfHash",
        "os",
        "arch"
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "wallS": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "startedAt",
        "endedAt",
        "wallS"
      ]
    },
    "frameHashes": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*\\\\)(?!(?:.*\\/)?\\.\\.(?:\\/|$)).+$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "engine",
    "target",
    "profile",
    "frames",
    "composition",
    "fps",
    "width",
    "height",
    "color",
    "mezzanine",
    "inputHash",
    "git",
    "toolchain",
    "timing",
    "warnings"
  ]
}
